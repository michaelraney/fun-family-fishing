config_version=5

[application]

config/name="Fishing Game"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[autoload]

SoundManager="*res://scripts/sound_manager.gd"
Leaderboard="*res://scripts/leaderboard.gd"

[display]

